{
  "Comment": "Cleaner coordination workflow - contacts cleaners in rank order until one confirms or all are exhausted",
  "StartAt": "InitializeState",
  "States": {
    "InitializeState": {
      "Type": "Pass",
      "Parameters": {
        "input.$": "$",
        "cleanerConfirmed": false,
        "allCleanersExhausted": false
      },
      "ResultPath": "$.state",
      "Next": "CheckCleanerList"
    },
    "CheckCleanerList": {
      "Type": "Pass",
      "Parameters": {
        "input.$": "$.state.input",
        "cleanersCount.$": "States.ArrayLength($.state.input.property.cleaners)"
      },
      "ResultPath": "$.state.checkData",
      "Next": "CompareCleanerIndex"
    },
    "CompareCleanerIndex": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.state.input.currentCleanerIndex",
          "NumericLessThanPath": "$.state.checkData.cleanersCount",
          "Next": "GetCurrentCleaner"
        }
      ],
      "Default": "PrepareEscalation"
    },
    "GetCurrentCleaner": {
      "Type": "Pass",
      "Parameters": {
        "input.$": "$.state.input",
        "currentCleaner.$": "States.ArrayGetItem($.state.input.property.cleaners, $.state.input.currentCleanerIndex)",
        "propertyName.$": "$.state.input.property.metadata.propertyName",
        "propertyAddress.$": "$.state.input.property.address",
        "cleaningDateTime.$": "$.state.input.cleaningDateTime",
        "cleaningDate.$": "States.ArrayGetItem(States.StringSplit($.state.input.cleaningDateTime, 'T'), 0)",
        "numberOfGuests.$": "$.state.input.booking.numberOfGuests",
        "numberOfNights.$": "$.state.input.booking.numberOfDays",
        "cleaningDuration.$": "$.state.input.property.metadata.cleaningDuration",
        "ownerName.$": "$.state.input.property.metadata.ownerName"
      },
      "ResultPath": "$.state",
      "Next": "SendCleanerNotifications"
    },
    "SendCleanerNotifications": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "SendCleanerEmail",
          "States": {
            "SendCleanerEmail": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:ses:sendEmail.waitForTaskToken",
              "TimeoutSeconds": 32400,
              "Parameters": {
                "Source.$": "$.state.input.ownerEmail",
                "Destination": {
                  "ToAddresses.$": "States.Array($.state.currentCleaner.email)"
                },
                "Message": {
                  "Subject": {
                    "Data.$": "States.Format('Cleaning Request for {} on {}', $.state.propertyName, $.state.cleaningDate)"
                  },
                  "Body": {
                    "Html": {
                      "Data.$": "States.Format('<p>Hello {}, please confirm cleaning for {}.</p><a href=\"{}/respond?token={}&response=yes\">YES</a> | <a href=\"{}/respond?token={}&response=no\">NO</a>', $.state.currentCleaner.name, $.state.propertyName, $.state.input.callbackApiUrl, $$.Task.Token, $.state.input.callbackApiUrl, $$.Task.Token)"
                    }
                  }
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "SendCleanerSMS",
          "States": {
            "SendCleanerSMS": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:sns:publish",
              "Parameters": {
                "PhoneNumber.$": "$.state.currentCleaner.phone",
                "Message.$": "States.Format('Cleaning request for {} on {}. Respond YES or NO: {}/respond?executionId={}&response=yes | {}/respond?executionId={}&response=no', $.state.propertyName, $.state.cleaningDate, $.state.input.callbackApiUrl, $$.Execution.Id, $.state.input.callbackApiUrl, $$.Execution.Id)"
              },
              "End": true
            }
          }
        }
      ],
      "Next": "EvaluateResponse"
    },
    "EvaluateResponse": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.emailResult.response",
          "StringEquals": "yes",
          "Next": "CleanerConfirmed"
        }
      ],
      "Default": "SendReminderNotifications"
    },
    "SendReminderNotifications": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "SendReminderEmail",
          "States": {
            "SendReminderEmail": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:ses:sendEmail.waitForTaskToken",
              "TimeoutSeconds": 10800,
              "Parameters": {
                "Source.$": "$.state.input.ownerEmail",
                "Destination": {
                  "ToAddresses.$": "States.Array($.state.currentCleaner.email)"
                },
                "Message": {
                  "Subject": {
                    "Data.$": "States.Format('Reminder: Cleaning Request for {}', $.state.propertyName)"
                  },
                  "Body": {
                    "Html": {
                      "Data.$": "States.Format('<p>Reminder for cleaning.</p><a href=\"{}/respond?token={}&response=yes\">YES</a> | <a href=\"{}/respond?token={}&response=no\">NO</a>', $.state.input.callbackApiUrl, $$.Task.Token, $.state.input.callbackApiUrl, $$.Task.Token)"
                    }
                  }
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "SendReminderSMS",
          "States": {
            "SendReminderSMS": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:sns:publish",
              "Parameters": {
                "PhoneNumber.$": "$.state.currentCleaner.phone",
                "Message.$": "States.Format('Reminder: cleaning request for {}. Respond here: {}/respond?executionId={}&response=yes | {}/respond?executionId={}&response=no', $.state.propertyName, $.state.input.callbackApiUrl, $$.Execution.Id, $.state.input.callbackApiUrl, $$.Execution.Id)"
              },
              "End": true
            }
          }
        }
      ],
      "Next": "IncrementCleanerIndex"
    },
    "IncrementCleanerIndex": {
      "Type": "Pass",
      "Parameters": {
        "input.$": "$.state.input"
      },
      "ResultPath": "$.state",
      "Next": "CheckCleanerList"
    },
    "CleanerConfirmed": {
      "Type": "Succeed"
    },
    "PrepareEscalation": {
      "Type": "Pass",
      "Comment": "Prepare escalation when all cleaners exhausted",
      "Next": "WorkflowFailed"
    },
    "WorkflowFailed": {
      "Type": "Fail",
      "Error": "NoCleanerAvailable",
      "Cause": "All cleaners in the list were contacted but none confirmed availability"
    }
  }
}