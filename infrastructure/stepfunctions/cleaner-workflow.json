{
  "Comment": "Cleaner coordination workflow - contacts cleaners in rank order until one confirms or all are exhausted",
  "StartAt": "InitializeState",
  "States": {
    "InitializeState": {
      "Type": "Pass",
      "Comment": "Initialize workflow state",
      "Parameters": {
        "input.$": "$",
        "cleanerConfirmed": false,
        "allCleanersExhausted": false
      },
      "ResultPath": "$.state",
      "Next": "CheckOwnerOverride"
    },
    "CheckOwnerOverride": {
      "Type": "Choice",
      "Comment": "Check if this is an owner override that skips to confirmation",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.state.input.ownerOverride",
              "IsPresent": true
            },
            {
              "Variable": "$.state.input.ownerOverride",
              "BooleanEquals": true
            }
          ],
          "Next": "CheckCleanerList"
        }
      ],
      "Default": "CheckCleanerList"
    },
    "CheckCleanerList": {
      "Type": "Pass",
      "Comment": "Get cleaner count for comparison",
      "Parameters": {
        "input.$": "$.state.input",
        "cleanersCount.$": "States.ArrayLength($.state.input.property.cleaners)"
      },
      "ResultPath": "$.state.checkData",
      "Next": "CompareCleanerIndex"
    },
    "CompareCleanerIndex": {
      "Type": "Choice",
      "Comment": "Check if current index is beyond cleaner list",
      "Choices": [
        {
          "Variable": "$.state.input.currentCleanerIndex",
          "NumericLessThanPath": "$.state.checkData.cleanersCount",
          "Next": "GetCurrentCleaner"
        }
      ],
      "Default": "PrepareEscalation"
    },
    "PrepareEscalation": {
      "Type": "Pass",
      "Comment": "Extract values needed for escalation email",
      "Parameters": {
        "input.$": "$.state.input",
        "propertyName.$": "$.state.input.property.metadata.propertyName",
        "propertyAddress.$": "$.state.input.property.address",
        "propertyId.$": "$.state.input.property.propertyId",
        "checkInDate.$": "$.state.input.booking.checkInDate",
        "checkOutDate.$": "$.state.input.booking.checkOutDate",
        "cleaningDate.$": "States.ArrayGetItem(States.StringSplit($.state.input.cleaningDateTime, 'T'), 0)",
        "numberOfGuests.$": "$.state.input.booking.numberOfGuests",
        "numberOfNights.$": "$.state.input.booking.numberOfDays",
        "platform.$": "$.state.input.booking.platform",
        "bookingRef.$": "$.state.input.booking.bookingReference",
        "guestName.$": "$.state.input.booking.guestName",
        "ownerName.$": "$.state.input.property.metadata.ownerName",
        "cleaners.$": "$.state.input.property.cleaners"
      },
      "ResultPath": "$.state",
      "Next": "SaveWorkflowContext"
    },
    "SaveWorkflowContext": {
      "Type": "Task",
      "Comment": "Save workflow context to S3 for owner override",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket.$": "$.state.input.bookingStateBucket",
        "Key.$": "States.Format('bookings/{}/{}_workflow-context.json', $.state.platform, $.state.bookingRef)",
        "Body.$": "States.JsonToString($.state.input)"
      },
      "ResultPath": "$.saveResult",
      "Next": "AllCleanersExhausted"
    },
    "GetCurrentCleaner": {
      "Type": "Pass",
      "Comment": "Extract current cleaner object from array",
      "Parameters": {
        "input.$": "$.state.input",
        "currentCleaner.$": "States.ArrayGetItem($.state.input.property.cleaners, $.state.input.currentCleanerIndex)",
        "propertyName.$": "$.state.input.property.metadata.propertyName",
        "propertyAddress.$": "$.state.input.property.address",
        "cleaningDateTime.$": "$.state.input.cleaningDateTime",
        "cleaningTime.$": "$.state.input.cleaningTime",
        "alternativeTimeSlots.$": "$.state.input.alternativeTimeSlots",
        "alternativeButtons.$": "$.state.input.alternativeButtons",
        "timeButtonsHtml.$": "$.state.input.timeButtonsHtml",
        "cleaningDate.$": "States.ArrayGetItem(States.StringSplit($.state.input.cleaningDateTime, 'T'), 0)",
        "numberOfGuests.$": "$.state.input.booking.numberOfGuests",
        "numberOfNights.$": "$.state.input.booking.numberOfDays",
        "cleaningDuration.$": "$.state.input.property.metadata.cleaningDuration",
        "ownerName.$": "$.state.input.property.metadata.ownerName",
        "cleanerConfirmed.$": "$.state.cleanerConfirmed",
        "allCleanersExhausted.$": "$.state.allCleanersExhausted",
        "checkData.$": "$.state.checkData"
      },
      "ResultPath": "$.state",
      "Next": "CheckForOwnerOverride"
    },
    "CheckForOwnerOverride": {
      "Type": "Choice",
      "Comment": "If owner override, skip sending request and go straight to confirmation",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.state.input.ownerOverride",
              "IsPresent": true
            },
            {
              "Variable": "$.state.input.ownerOverride",
              "BooleanEquals": true
            }
          ],
          "Next": "ProcessCleanerResponse"
        }
      ],
      "Default": "FormatCleaningDate"
    },
    "FormatCleaningDate": {
      "Type": "Pass",
      "Comment": "Reformat date from YYYY-MM-DD to MM-DD-YYYY",
      "Parameters": {
        "input.$": "$.state.input",
        "currentCleaner.$": "$.state.currentCleaner",
        "propertyName.$": "$.state.propertyName",
        "propertyAddress.$": "$.state.propertyAddress",
        "cleaningDateTime.$": "$.state.cleaningDateTime",
        "cleaningTime.$": "$.state.cleaningTime",
        "alternativeTimeSlots.$": "$.state.alternativeTimeSlots",
        "alternativeButtons.$": "$.state.alternativeButtons",
        "timeButtonsHtml.$": "$.state.timeButtonsHtml",
        "numberOfGuests.$": "$.state.numberOfGuests",
        "numberOfNights.$": "$.state.numberOfNights",
        "cleaningDuration.$": "$.state.cleaningDuration",
        "ownerName.$": "$.state.ownerName",
        "cleanerConfirmed.$": "$.state.cleanerConfirmed",
        "allCleanersExhausted.$": "$.state.allCleanersExhausted",
        "checkData.$": "$.state.checkData",
        "cleaningDate.$": "States.Format('{}-{}-{}', States.ArrayGetItem(States.StringSplit($.state.cleaningDate, '-'), 1), States.ArrayGetItem(States.StringSplit($.state.cleaningDate, '-'), 2), States.ArrayGetItem(States.StringSplit($.state.cleaningDate, '-'), 0))"
      },
      "ResultPath": "$.state",
      "Next": "SendCleanerRequest"
    },
    "SendCleanerRequest": {
      "Type": "Task",
      "Comment": "Send email to cleaner requesting availability with callback links",
      "Resource": "arn:aws:states:::aws-sdk:ses:sendEmail.waitForTaskToken",
      "TimeoutSeconds": 32400,
      "Parameters": {
        "Source.$": "$.state.input.ownerEmail",
        "Destination": {
          "ToAddresses.$": "States.Array($.state.currentCleaner.email)",
          "CcAddresses.$": "States.Array($.state.input.ownerEmail)"
        },
        "Message": {
          "Subject": {
            "Data.$": "States.Format('Cleaning Request for {} on {}', $.state.propertyName, $.state.cleaningDate)"
          },
          "Body": {
            "Html": {
              "Data.$": "States.Format('<html><body><p>Hello {},</p><p>We have a new booking for <strong>{}</strong> and need a cleaning and laundry turnover.</p><p><strong>Details:</strong></p><ul><li>Date: {}</li><li>Time: {}</li><li>Address: {}</li><li>Guests: {}</li><li>Nights: {}</li></ul><p>Are you available on {} at {} to do a cleaning and laundry turnover at {}?</p><p style=\"margin: 30px 0;\"><a href=\"{}/respond?token={}&response=yes\" style=\"background-color: #28a745; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; margin-right: 10px;\">YES</a><a href=\"{}/respond?token={}&response=no\" style=\"background-color: #dc3545; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">NO</a></p><p style=\"margin: 20px 0; padding: 15px; background-color: #f8f9fa; border-radius: 5px;\"><strong style=\"display: block; margin-bottom: 10px;\">Or select an alternative time to schedule:</strong>{}{}{}{}{}</p><p>Thank you,<br>{}</p></body></html>', $.state.currentCleaner.name, $.state.propertyName, $.state.cleaningDate, $.state.cleaningTime, $.state.propertyAddress, $.state.numberOfGuests, $.state.numberOfNights, $.state.cleaningDate, $.state.cleaningTime, $.state.propertyAddress, $.state.input.callbackApiUrl, $$.Task.Token, $.state.input.callbackApiUrl, $$.Task.Token, States.Format($.state.alternativeButtons[0], $.state.input.callbackApiUrl, $$.Task.Token), States.Format($.state.alternativeButtons[1], $.state.input.callbackApiUrl, $$.Task.Token), States.Format($.state.alternativeButtons[2], $.state.input.callbackApiUrl, $$.Task.Token), States.Format($.state.alternativeButtons[3], $.state.input.callbackApiUrl, $$.Task.Token), States.Format($.state.alternativeButtons[4], $.state.input.callbackApiUrl, $$.Task.Token), $.state.ownerName)"
            }
          }
        }
      },
      "ResultPath": "$.emailResult",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.error",
          "Next": "SendReminderEmail"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "IncrementCleanerIndex"
        }
      ],
      "Next": "EvaluateResponse"
    },
    "EvaluateResponse": {
      "Type": "Choice",
      "Comment": "Check if cleaner confirmed availability or declined",
      "Choices": [
        {
          "Variable": "$.emailResult.response",
          "StringEquals": "yes",
          "Next": "ProcessCleanerResponse"
        },
        {
          "Variable": "$.emailResult.response",
          "StringEquals": "no",
          "Next": "IncrementCleanerIndex"
        }
      ],
      "Default": "SendReminderEmail"
    },
    "SendReminderEmail": {
      "Type": "Task",
      "Comment": "Send reminder email to cleaner after no response to initial request",
      "Resource": "arn:aws:states:::aws-sdk:ses:sendEmail.waitForTaskToken",
      "TimeoutSeconds": 10800,
      "Parameters": {
        "Source.$": "$.state.input.ownerEmail",
        "Destination": {
          "ToAddresses.$": "States.Array($.state.currentCleaner.email)",
          "CcAddresses.$": "States.Array($.state.input.ownerEmail)"
        },
        "Message": {
          "Subject": {
            "Data.$": "States.Format('Reminder: Cleaning Request for {} on {}', $.state.propertyName, $.state.cleaningDate)"
          },
          "Body": {
            "Html": {
              "Data.$": "States.Format('<html><body><p>Hello {},</p><p>This is a reminder regarding the cleaning request for <strong>{}</strong> on {}. Please respond if you are available.</p><p style=\"margin: 30px 0;\"><a href=\"{}/respond?token={}&response=yes\" style=\"background-color: #28a745; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; margin-right: 10px;\">YES</a><a href=\"{}/respond?token={}&response=no\" style=\"background-color: #dc3545; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;\">NO</a></p><p>Thank you,<br>{}</p></body></html>', $.state.currentCleaner.name, $.state.propertyName, $.state.cleaningDate, $.state.input.callbackApiUrl, $$.Task.Token, $.state.input.callbackApiUrl, $$.Task.Token, $.state.ownerName)"
            }
          }
        }
      },
      "ResultPath": "$.reminderResult",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.reminderError",
          "Next": "IncrementCleanerIndex"
        }
      ],
      "Next": "EvaluateReminderResponse"
    },
    "EvaluateReminderResponse": {
      "Type": "Choice",
      "Comment": "Check if cleaner confirmed after reminder",
      "Choices": [
        {
          "Variable": "$.reminderResult.response",
          "StringEquals": "yes",
          "Next": "ProcessCleanerResponse"
        }
      ],
      "Default": "IncrementCleanerIndex"
    },
    "ProcessCleanerResponse": {
      "Type": "Choice",
      "Comment": "Check if alternative time was selected",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.emailResult.alternativeTime",
              "IsPresent": true
            },
            {
              "Not": {
                "Variable": "$.emailResult.alternativeTime",
                "StringEquals": ""
              }
            }
          ],
          "Next": "UpdateCleaningTimeForAlternative"
        }
      ],
      "Default": "CleanerConfirmed"
    },
    "UpdateCleaningTimeForAlternative": {
      "Type": "Pass",
      "Comment": "Extract date and time parts from alternative time ISO string",
      "Parameters": {
        "state.$": "$.state",
        "bookingStateBucket.$": "$.bookingStateBucket",
        "emailResult.$": "$.emailResult",
        "alternativeTime.$": "$.emailResult.alternativeTime",
        "dateTimeParts.$": "States.StringSplit($.emailResult.alternativeTime, 'T')"
      },
      "Next": "FormatAlternativeDate"
    },
    "FormatAlternativeDate": {
      "Type": "Pass",
      "Comment": "Format the alternative date from YYYY-MM-DD to MM-DD-YYYY",
      "Parameters": {
        "state.$": "$.state",
        "bookingStateBucket.$": "$.bookingStateBucket",
        "alternativeTime.$": "$.alternativeTime",
        "datePart.$": "States.ArrayGetItem($.dateTimeParts, 0)",
        "timePart.$": "States.ArrayGetItem($.dateTimeParts, 1)",
        "dateParts.$": "States.StringSplit(States.ArrayGetItem($.dateTimeParts, 0), '-')"
      },
      "Next": "FormatAlternativeTime"
    },
    "FormatAlternativeTime": {
      "Type": "Pass",
      "Comment": "Format the alternative time to HH:MM",
      "Parameters": {
        "state.$": "$.state",
        "bookingStateBucket.$": "$.bookingStateBucket",
        "alternativeTime.$": "$.alternativeTime",
        "formattedDate.$": "States.Format('{}-{}-{}', States.ArrayGetItem($.dateParts, 1), States.ArrayGetItem($.dateParts, 2), States.ArrayGetItem($.dateParts, 0))",
        "timeParts.$": "States.StringSplit($.timePart, ':')"
      },
      "Next": "ApplyAlternativeTime"
    },
    "ApplyAlternativeTime": {
      "Type": "Pass",
      "Comment": "Apply the formatted alternative date/time to state",
      "Parameters": {
        "state": {
          "input.$": "$.state.input",
          "currentCleaner.$": "$.state.currentCleaner",
          "propertyName.$": "$.state.propertyName",
          "propertyAddress.$": "$.state.propertyAddress",
          "numberOfGuests.$": "$.state.numberOfGuests",
          "numberOfNights.$": "$.state.numberOfNights",
          "cleaningDateTime.$": "$.alternativeTime",
          "cleaningDate.$": "$.formattedDate",
          "cleaningTime.$": "States.Format('{}:{}', States.ArrayGetItem($.timeParts, 0), States.ArrayGetItem($.timeParts, 1))",
          "cleaningDuration.$": "$.state.cleaningDuration",
          "ownerName.$": "$.state.ownerName",
          "cleanerConfirmed.$": "$.state.cleanerConfirmed",
          "allCleanersExhausted.$": "$.state.allCleanersExhausted",
          "checkData.$": "$.state.checkData",
          "alternativeTimeSlots.$": "$.state.alternativeTimeSlots"
        },
        "bookingStateBucket.$": "$.bookingStateBucket"
      },
      "Next": "CleanerConfirmed"
    },
    "CleanerConfirmed": {
      "Type": "Parallel",
      "Comment": "Send confirmation to cleaner and notification to owner",
      "Branches": [
        {
          "StartAt": "SendCleanerConfirmation",
          "States": {
            "SendCleanerConfirmation": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${CalendarLambdaArn}",
                "Payload": {
                  "FromEmail.$": "$.state.input.ownerEmail",
                  "ToEmail.$": "$.state.currentCleaner.email",
                  "CcEmail.$": "$.state.input.ownerEmail",
                  "Subject.$": "States.Format('Cleaning Confirmed for {} on {}', $.state.propertyName, $.state.cleaningDate)",
                  "HtmlBody.$": "States.Format('<html><body><p>Hello {},</p><p>Thank you for confirming your availability!</p><p>Your cleaning appointment has been scheduled:</p><ul><li>Property: {}</li><li>Date: {}</li><li>Time: {}</li><li>Address: {}</li></ul><p>Please see the attached calendar invite.</p><p>Thank you,<br/>{}</p></body></html>', $.state.currentCleaner.name, $.state.propertyName, $.state.cleaningDate, $.state.cleaningTime, $.state.propertyAddress, $.state.ownerName)",
                  "CleanerName.$": "$.state.currentCleaner.name",
                  "CleanerId.$": "$.state.currentCleaner.cleanerId",
                  "CleanerEmail.$": "$.state.currentCleaner.email",
                  "CleanerPhone.$": "$.state.currentCleaner.phone",
                  "OwnerName.$": "$.state.ownerName",
                  "OwnerEmail.$": "$.state.input.ownerEmail",
                  "PropertyName.$": "$.state.propertyName",
                  "PropertyAddress.$": "$.state.propertyAddress",
                  "CleaningDate.$": "$.state.cleaningDate",
                  "CleaningDateTime.$": "$.state.cleaningDateTime",
                  "CleaningDuration.$": "$.state.cleaningDuration",
                  "Platform.$": "$.state.input.booking.platform",
                  "BookingReference.$": "$.state.input.booking.bookingReference",
                  "BookingStateBucket.$": "$.bookingStateBucket"
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "SendOwnerNotification",
          "States": {
            "SendOwnerNotification": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${CalendarLambdaArn}",
                "Payload": {
                  "FromEmail.$": "$.state.input.ownerEmail",
                  "ToEmail.$": "$.state.input.ownerEmail",
                  "CcEmail": "",
                  "Subject.$": "States.Format('Cleaning Scheduled for {} on {}', $.state.propertyName, $.state.cleaningDate)",
                  "HtmlBody.$": "States.Format('<html><body><p>Hello {},</p><p>A cleaning has been scheduled for {}:</p><ul><li>Cleaner: {}</li><li>Email: {}</li><li>Phone: {}</li><li>Date: {}</li><li>Time: {}</li><li>Address: {}</li></ul><p>Please see the attached calendar invite with cleaner contact information.</p><p style=\"margin-top: 25px; padding: 15px; background-color: #f8f9fa; border-left: 4px solid #dc3545; border-radius: 4px;\"><strong style=\"color: #495057;\">Need to cancel?</strong> <a href=\"{}/respond?cancelToken={}&bookingRef={}&platform={}&propertyId={}&cleanerId={}\" style=\"color: #c82333; text-decoration: underline; font-weight: 600;\">Click here to cancel this cleaning</a></p><p>Thank you,<br/>{}</p></body></html>', $.state.ownerName, $.state.propertyName, $.state.currentCleaner.name, $.state.currentCleaner.email, $.state.currentCleaner.phone, $.state.cleaningDate, $.state.cleaningTime, $.state.propertyAddress, $.state.input.callbackApiUrl, $.state.input.ownerToken, $.state.input.booking.bookingReference, $.state.input.booking.platform, $.state.input.property.propertyId, $.state.currentCleaner.cleanerId, $.state.ownerName)",
                  "CleanerName.$": "$.state.currentCleaner.name",
                  "CleanerId.$": "$.state.currentCleaner.cleanerId",
                  "CleanerEmail.$": "$.state.currentCleaner.email",
                  "CleanerPhone.$": "$.state.currentCleaner.phone",
                  "OwnerName.$": "$.state.ownerName",
                  "OwnerEmail.$": "$.state.input.ownerEmail",
                  "PropertyName.$": "$.state.propertyName",
                  "PropertyAddress.$": "$.state.propertyAddress",
                  "CleaningDate.$": "$.state.cleaningDate",
                  "CleaningDateTime.$": "$.state.cleaningDateTime",
                  "CleaningDuration.$": "$.state.cleaningDuration",
                  "Platform.$": "$.state.input.booking.platform",
                  "BookingReference.$": "$.state.input.booking.bookingReference",
                  "BookingStateBucket.$": "$.bookingStateBucket"
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "WorkflowSuccess"
    },
    "IncrementCleanerIndex": {
      "Type": "Pass",
      "Comment": "Move to next cleaner in list",
      "Parameters": {
        "input": {
          "booking.$": "$.state.input.booking",
          "property.$": "$.state.input.property",
          "cleaningDateTime.$": "$.state.input.cleaningDateTime",
          "currentCleanerIndex.$": "States.MathAdd($.state.input.currentCleanerIndex, 1)",
          "attemptCount.$": "States.MathAdd($.state.input.attemptCount, 1)",
          "ownerEmail.$": "$.state.input.ownerEmail",
          "callbackApiUrl.$": "$.state.input.callbackApiUrl",
          "bookingStateBucket.$": "$.state.input.bookingStateBucket",
          "escalationEmailHtml.$": "$.state.input.escalationEmailHtml",
          "ownerToken.$": "$.state.input.ownerToken"
        },
        "cleanerConfirmed": false,
        "allCleanersExhausted": false
      },
      "ResultPath": "$.state",
      "Next": "CheckCleanerList"
    },
    "AllCleanersExhausted": {
      "Type": "Task",
      "Comment": "Send escalation email to owner with pre-generated HTML",
      "Resource": "arn:aws:states:::aws-sdk:ses:sendEmail",
      "Parameters": {
        "Source.$": "$.state.input.ownerEmail",
        "Destination": {
          "ToAddresses.$": "States.Array($.state.input.ownerEmail)"
        },
        "Message": {
          "Subject": {
            "Data.$": "States.Format('URGENT: Unable to Schedule Cleaning for {} on {}', $.state.propertyName, $.state.cleaningDate)"
          },
          "Body": {
            "Html": {
              "Data.$": "$.state.input.escalationEmailHtml"
            }
          }
        }
      },
      "ResultPath": "$.escalationResult",
      "Next": "WorkflowFailed"
    },
    "WorkflowSuccess": {
      "Type": "Succeed",
      "Comment": "Workflow completed successfully - cleaner confirmed"
    },
    "WorkflowFailed": {
      "Type": "Fail",
      "Comment": "Workflow failed - no cleaner available",
      "Error": "NoCleanerAvailable",
      "Cause": "All cleaners in the list were contacted but none confirmed availability"
    }
  }
}